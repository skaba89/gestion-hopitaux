# =============================================================================
# HealthFlow Guinea - Docker Ignore
# Exclude files/directories from Docker build context
# =============================================================================

# Version control
.git
.gitignore
.gitattributes

# CI/CD
.github
.gitlab-ci.yml

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Docker files (avoid recursive context)
docker/
docker-compose*.yml
Dockerfile*

# Environment files
.env
.env.*
!.env.example

# Documentation
docs/
*.md
README*
LICENSE
CHANGELOG*

# Test files
test/
tests/
__tests__/
*.test.ts
*.test.tsx
*.test.js
*.spec.ts
*.spec.tsx
*.spec.js
coverage/
.nyc_output/

# Build artifacts and caches
.next/
out/
dist/
build/
.cache/
*.tsbuildinfo

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*

# Database
db/
*.db
*.sqlite
*.sqlite3
prisma/migrations/

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp

# Deployment configs (not needed in build context)
k8s/
nginx/

# MinIO data
data/

# Misc
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
