# ============================================================================
# HealthFlow Guinea - Environment Configuration
# ============================================================================

# Database - PostgreSQL 17
DATABASE_URL=postgresql://z@localhost:5433/healthflow?schema=public

# Redis - For sessions, OTP store, rate limiting
REDIS_URL="redis://localhost:6380"

# NextAuth
NEXTAUTH_SECRET="healthflow-guinea-production-secret-change-me-in-production-2024"
NEXTAUTH_URL="http://localhost:3000"

# JWT Secret (for patient portal tokens)
JWT_SECRET="healthflow-guinea-jwt-secret-change-me-in-production-2024"

# Encryption - AES-256-GCM key (32 bytes hex)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ============================================================================
# SMS Provider: demo | orange | twilio | vonage
# ============================================================================
SMS_PROVIDER="demo"
SMS_FALLBACK_PROVIDER=""

# Orange SMS API (Guinea)
ORANGE_SMS_TOKEN=""
ORANGE_SMS_SENDER="tel:+224000"

# Twilio SMS (International fallback)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_WHATSAPP_NUMBER=""

# Vonage/Nexmo SMS (Alternative fallback)
VONAGE_API_KEY=""
VONAGE_API_SECRET=""
VONAGE_FROM_NAME="HealthFlow"

# ============================================================================
# Mobile Money - Orange Money & MTN MoMo
# ============================================================================

# Orange Money Guinea
ORANGE_MONEY_CLIENT_ID=""
ORANGE_MONEY_CLIENT_SECRET=""
ORANGE_MONEY_MERCHANT_CODE=""
ORANGE_MONEY_PIN=""
ORANGE_MONEY_API_URL="https://api.orange.com/omewallet/gn/v1"

# MTN MoMo Guinea
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_KEY=""
MTN_MOMO_USER_ID=""
MTN_MOMO_API_URL="https://sandbox.momodeveloper.mtn.com"
MTN_MOMO_ENVIRONMENT="sandbox"
MTN_MOMO_CALLBACK_HOST="localhost:3000"

# ============================================================================
# WhatsApp Business API
# ============================================================================
WHATSAPP_PROVIDER="demo"
# Meta WhatsApp Cloud API
META_WHATSAPP_TOKEN=""
META_WHATSAPP_PHONE_ID=""
# OR Twilio WhatsApp
# (Uses TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_WHATSAPP_NUMBER from above)

# ============================================================================
# DHIS2 - Guinea National Health Information System
# ============================================================================
DHIS2_BASE_URL="https://dhis2.health.gov.gn"
DHIS2_USERNAME=""
DHIS2_PASSWORD=""
DHIS2_ORG_UNIT=""
DHIS2_DATA_SET_ID="DS-HF-REPORT"
DHIS2_MTRAC_PROGRAM_ID=""

# ============================================================================
# DICOM/Orthanc - Medical Imaging PACS
# ============================================================================
# CHU Donka PACS
ORTHANC_DONKA_URL=""
ORTHANC_DONKA_USER="orthanc"
ORTHANC_DONKA_PASSWORD=""
# CHU Ignace Deen PACS
ORTHANC_IGNACE_URL=""
ORTHANC_IGNACE_USER="orthanc"
ORTHANC_IGNACE_PASSWORD=""
# DICOM Viewer URL (OHIF or DWV)
NEXT_PUBLIC_DICOM_VIEWER_URL="/dicom-viewer"

# ============================================================================
# General
# ============================================================================
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"
ALLOWED_ORIGINS="http://localhost:3000"

# Demo Mode (disables auth for development)
DEMO_MODE="true"

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="HealthFlow Guinea"
