# ============================================================================
# MESSAGING PROVIDERS — Free & Paid Options
# ============================================================================

# --- Telegram Bot (100% FREE, Unlimited) ---
# Setup: Chat with @BotFather on Telegram → /newbot → copy token here
# Docs: https://core.telegram.org/bots/api
TELEGRAM_BOT_TOKEN=
# Your chat ID (send /chatid to your bot to get it)
TELEGRAM_DEFAULT_CHAT_ID=
# Admin chat IDs for system alerts (comma-separated)
TELEGRAM_ADMIN_CHAT_IDS=
# Optional: webhook secret for extra security
TELEGRAM_WEBHOOK_SECRET=

# --- SMS Provider (primary) ---
# Options: demo | telegram | orange | twilio | vonage
# 'telegram' = 100% free, 'orange' = best for Guinea, 'demo' = console only
SMS_PROVIDER=demo
SMS_FALLBACK_PROVIDER=

# --- Orange SMS API (Guinea) ---
# Get token: https://developer.orange.com/apis/sms-guinee
ORANGE_SMS_TOKEN=
ORANGE_SMS_SENDER=tel:+224000

# --- Twilio (SMS + WhatsApp) ---
# Free trial: https://www.twilio.com/try-twilio
# WhatsApp Sandbox: https://console.twilio.com/us1/develop/sms/try-it-out/whatsapp-learn
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# --- Vonage (Nexmo) SMS ---
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM_NAME=HealthFlow

# --- WhatsApp Provider ---
# Options: demo | twilio | meta
WHATSAPP_PROVIDER=demo

# --- Meta WhatsApp Cloud API ---
# Free sandbox: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
